# Copy this file to .env and fill in real values. .env is git-ignored.
# URL-encode special characters in passwords (e.g. '#' becomes %23).

DATABASE_URL="mysql://root:YOUR_PASSWORD@127.0.0.1:3306/g1"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"